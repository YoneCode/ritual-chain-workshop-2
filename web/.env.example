# Deployed RitualPredict address. Print it with:
#   cd hardhat && pnpm exec hardhat run scripts/deploy.ts
NEXT_PUBLIC_PREDICT_ADDRESS=0x0000000000000000000000000000000000000000

# 1979 = Ritual Chain testnet, 31337 = the local Hardhat node
NEXT_PUBLIC_CHAIN_ID=31337

# Override only if you run your own node
NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
